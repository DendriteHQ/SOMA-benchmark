OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=soma-bench

# Benchmark runner runtime LLM
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_VERSION=

# Optional token for gated/private benchmark datasets on Hugging Face
HF_TOKEN=

# Benchmark runner global settings
SOMA_BENCHMARK_OUTPUT_DIR=outputs/soma-bench-local
SOMA_BENCHMARK_WORKSPACE=docker
SOMA_BENCHMARK_MAX_ITERATIONS=100
SOMA_BENCHMARK_EXECUTE=false

# Optional OpenClaw runtime overrides
SOMA_OPENCLAW_PLUGIN_PATH=
SOMA_OPENCLAW_PLUGIN_REINSTALL_ON_RUN_START=false

# Docker Hub credentials used for every authenticated registry call: manifest checks and
# pushes in the `soma-bench benchmark-prebake-dind-images` build tool, and the runtime's
# `docker pull` of a pre-baked dind image. They are materialized into a process-private
# DOCKER_CONFIG (see registry_auth.py), so ~/.docker/config.json is never read or written
# and no out-of-band `docker login` is needed on runtime hosts. Left empty, the build tool
# runs in local-only mode (build + commit + verify, no push) and pulls fall back to
# whatever ambient docker credentials the host happens to have.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Private repo (e.g. myorg/soma-swebench-dind) holding pre-baked dind images with a
# SWE-bench sandbox image already loaded inside. When set, the Copilot backend's dind
# sidecar tries this instance's tag first, before falling back to a plain dind daemon
# with the usual on-demand save/load. Leave empty to disable (default, no behavior change).
SOMA_SWEBENCH_DIND_PREBAKED_REPO=

